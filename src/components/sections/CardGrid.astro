---
import type { CardGrid } from './CardGrid.schema';
import Section from '../ui/Section.astro';
import Heading from '../ui/Heading.astro';
import { childLevel } from '../../lib/section-base';
import Prose from '../ui/Prose.astro';
import DimensionLine from '../ui/DimensionLine.astro';

type Props = CardGrid;

const {
	headingLevel = 'h2',
	eyebrow,
	heading,
	intro,
	columns = '3',
	cards = [],
	anchor,
	surface = 'light',
	spacing = 'md',
	width = 'wide',
} = Astro.props;

const onDark = surface === 'dark' || surface === 'brand';

const gridCols = {
	'2': 'sm:grid-cols-2',
	'3': 'sm:grid-cols-2 lg:grid-cols-3',
	'4': 'sm:grid-cols-2 lg:grid-cols-4',
	'5': 'sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5',
};

// Narrow cards get a taller frame so a 5-across row does not read as a strip
// of postage stamps; wider layouts keep the classic landscape crop.
const imageAspect = {
	'2': 'aspect-4/3',
	'3': 'aspect-4/3',
	'4': 'aspect-square',
	'5': 'aspect-[4/5]',
}[columns];
---

<Section anchor={anchor} surface={surface} spacing={spacing} width={width}>
	{(eyebrow || heading || intro) && (
		<header class="mb-14 max-w-2xl">
			{eyebrow && (
				<DimensionLine label={eyebrow} rule="both" onDark={onDark} class="mb-6 max-w-xs" />
			)}
			{heading && (
				<Heading level={headingLevel} size="lg">
					{heading}
				</Heading>
			)}
			{intro && <Prose html={intro} invert={onDark} class="mt-6" />}
		</header>
	)}

	<ul class={`grid gap-x-8 gap-y-14 ${gridCols[columns]}`}>
		{cards.map((card) => (
			<li class="group relative flex flex-col transition-transform duration-300 ease-out hover:-translate-y-1">
				{card.image && (
					<div class={`mb-7 overflow-hidden rounded-(--radius-media) ${imageAspect}`}>
						<img
							src={card.image.src}
							alt={card.image.alt}
							loading="lazy"
							class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.04]"
						/>
					</div>
				)}
				<Heading level={childLevel(headingLevel, Boolean(heading))} size="md">
					{card.link ? (
						<a href={card.link.href} class="transition-colors hover:text-brand">
							{/* Stretched so the whole card is the hit target, not just the words. */}
							<span class="absolute inset-0" aria-hidden="true" />
							{card.title}
						</a>
					) : (
						card.title
					)}
				</Heading>
				{card.body && <p class="mt-3.5 text-sm leading-relaxed opacity-90">{card.body}</p>}
				{/*
					`mt-auto` pins the link to the card's bottom edge so every card in a row
					lines its label up on one baseline, however long the body copy runs.
					`pt-6` keeps a minimum gap when a short body lets the auto-margin collapse.
				*/}
				{card.link && (
					<p
						class={`mt-auto flex items-center gap-2 pt-6 font-mono text-[0.6875rem] uppercase tracking-[0.14em] ${
							onDark ? 'text-accent' : 'text-accent-ink'
						}`}
					>
						<span class="transition-transform duration-300 group-hover:translate-x-1">
							{card.link.label}
						</span>
						<span
							aria-hidden="true"
							class={`h-px w-6 origin-left transition-transform duration-300 group-hover:scale-x-150 ${
								onDark ? 'bg-accent/50' : 'bg-accent-ink/50'
							}`}
						/>
					</p>
				)}
			</li>
		))}
	</ul>
</Section>
