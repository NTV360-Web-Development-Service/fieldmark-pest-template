---
import type { CardGrid } from './CardGrid.schema';
import Section from '../ui/Section.astro';
import Heading from '../ui/Heading.astro';
import SectionHead from '../ui/SectionHead.astro';
import { childLevel } from '../../lib/section-base';

type Props = CardGrid;

const {
	headingLevel = 'h2',
	eyebrow,
	heading,
	intro,
	layout = 'index',
	columns = '3',
	cards = [],
	anchor,
	surface = 'light',
	spacing = 'md',
	width = 'wide',
} = Astro.props;

const onDark = surface === 'dark' || surface === 'brand';
const cardLevel = childLevel(headingLevel, Boolean(heading));

const tileCols = {
	'2': 'sm:grid-cols-2',
	'3': 'sm:grid-cols-2 lg:grid-cols-3',
	'4': 'sm:grid-cols-2 lg:grid-cols-4',
	'5': 'sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5',
};
---

<Section anchor={anchor} surface={surface} spacing={spacing} width={width}>
	<SectionHead
		eyebrow={eyebrow}
		heading={heading}
		intro={intro}
		level={headingLevel}
		onDark={onDark}
	/>

	{layout === 'tiles' && (
		/*
			Photo tiles: each card is a tall specimen plate, the photo graded down
			to navy so the title reads over it. Hover brings the photo to colour,
			pushes it in a touch and runs the orange rule along the foot.
		*/
		<ul class={`grid gap-4 ${tileCols[columns]}`}>
			{cards.map((card, i) => (
				<li class="group relative flex aspect-[3/4] flex-col justify-end overflow-hidden bg-dark text-dark-fg [&_:is(h2,h3,h4)]:!text-current">
					{card.image && (
						<img
							src={card.image.src}
							alt={card.image.alt}
							loading="lazy"
							class="absolute inset-0 h-full w-full object-cover grayscale transition-[filter,transform] duration-500 group-hover:scale-105 group-hover:grayscale-0"
						/>
					)}
					<span
						class="absolute inset-0 bg-gradient-to-t from-dark via-dark/60 to-dark/0"
						aria-hidden="true"
					/>
					<span class="absolute top-5 left-5 font-mono text-sm font-semibold text-accent">
						{String(i + 1).padStart(2, '0')}
					</span>

					<div class="relative p-5 lg:p-6">
						<Heading level={cardLevel} size="md">
							{card.link ? (
								<a href={card.link.href}>
									<span class="absolute inset-0 z-[1]" aria-hidden="true" />
									{card.title}
								</a>
							) : (
								card.title
							)}
						</Heading>
						{card.body && (
							<p class="mt-2 line-clamp-3 min-h-[3lh] text-sm leading-relaxed opacity-80">{card.body}</p>
						)}
						{card.link && (
							<p class="mono-label mt-4 flex items-center gap-2 font-semibold text-accent">
								{card.link.label}
								<svg
									viewBox="0 0 16 16"
									class="h-3 w-3 fill-current transition-transform duration-200 group-hover:translate-x-1.5"
									aria-hidden="true"
								>
									<path d="M8.8 2.4l5 5-5 5-1.1-1.1 3.1-3.1H2v-1.6h8.8L7.7 3.5z" />
								</svg>
							</p>
						)}
					</div>

					<span
						class="absolute inset-x-0 bottom-0 h-1 origin-left scale-x-0 bg-cta transition-transform duration-300 group-hover:scale-x-100"
						aria-hidden="true"
					/>
				</li>
			))}
		</ul>
	)}

	{/*
		A specimen index rather than a card row: one ruled entry per item with
		the title set huge. Hovering an entry floods it with the signal colour and
		opens its specimen plate wide; the whole row is the link.
	*/}
	{layout === 'index' && (
	<ol class={`border-b ${onDark ? 'border-current/40' : 'border-line'}`}>
		{cards.map((card, i) => (
			<li
				class={`group relative grid grid-cols-[2.5rem_1fr] items-center gap-x-5 gap-y-3 border-t py-6 transition-colors duration-200 md:grid-cols-[4rem_minmax(0,1.1fr)_minmax(0,1fr)_auto] md:gap-x-8 ${
					onDark
						? 'border-current/40 hover:bg-accent hover:text-accent-fg'
						: 'border-line hover:bg-accent hover:text-accent-fg'
				}`}
			>
				<span class="self-start pt-2 font-mono text-sm font-semibold md:pl-4">
					{String(i + 1).padStart(2, '0')}
				</span>

				<Heading
					level={cardLevel}
					size="xl"
					display
					class="!text-[clamp(2rem,4.6vw,4rem)] group-hover:!text-accent-fg"
				>
					{card.link ? (
						<a href={card.link.href} class="focus-visible:outline-offset-8">
							{/* Stretched so the whole row is the hit target, not just the words. */}
							<span class="absolute inset-0 z-[1]" aria-hidden="true" />
							{card.title}
						</a>
					) : (
						card.title
					)}
				</Heading>

				<div class="col-start-2 md:col-start-auto">
					{card.body && <p class="max-w-md text-sm leading-relaxed opacity-85">{card.body}</p>}
					{card.link && (
						<p class="mono-label mt-3 flex items-center gap-2 font-semibold">
							{card.link.label}
							<svg
								viewBox="0 0 16 16"
								class="h-3 w-3 fill-current transition-transform duration-200 group-hover:translate-x-1.5"
								aria-hidden="true"
							>
								<path d="M8.8 2.4l5 5-5 5-1.1-1.1 3.1-3.1H2v-1.6h8.8L7.7 3.5z" />
							</svg>
						</p>
					)}
				</div>

				{card.image && (
					<div class="col-span-2 h-40 overflow-hidden border border-line bg-dark md:col-span-1 md:mr-4 md:h-24 md:w-36 md:transition-[height,width] md:duration-300 md:ease-out md:group-hover:h-40 md:group-hover:w-60">
						<img
							src={card.image.src}
							alt={card.image.alt}
							loading="lazy"
							class="h-full w-full object-cover grayscale transition-[filter] duration-300 group-hover:grayscale-0"
						/>
					</div>
				)}
			</li>
		))}
	</ol>
	)}
</Section>
