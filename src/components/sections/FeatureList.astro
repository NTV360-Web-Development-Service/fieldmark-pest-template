---
import type { FeatureList } from './FeatureList.schema';
import Section from '../ui/Section.astro';
import Heading from '../ui/Heading.astro';
import { childLevel } from '../../lib/section-base';
import Prose from '../ui/Prose.astro';
import DimensionLine from '../ui/DimensionLine.astro';

type Props = FeatureList;

const {
	headingLevel = 'h2',
	eyebrow,
	heading,
	intro,
	columns = '3',
	items = [],
	anchor,
	surface = 'light',
	spacing = 'md',
	width = 'wide',
} = Astro.props;

const onDark = surface === 'dark' || surface === 'brand';

const gridCols = {
	'2': 'sm:grid-cols-2',
	'3': 'sm:grid-cols-2 lg:grid-cols-3',
	'4': 'sm:grid-cols-2 lg:grid-cols-4',
};
---

<Section anchor={anchor} surface={surface} spacing={spacing} width={width}>
	{(eyebrow || heading || intro) && (
		<header class="mb-14 max-w-2xl">
			{eyebrow && (
				<DimensionLine label={eyebrow} rule="both" onDark={onDark} class="mb-6 max-w-xs" />
			)}
			{heading && (
				<Heading level={headingLevel} size="lg">
					{heading}
				</Heading>
			)}
			{intro && <Prose html={intro} invert={onDark} class="mt-6" />}
		</header>
	)}

	<ul class={`grid gap-x-8 gap-y-10 ${gridCols[columns]}`}>
		{items.map((item) => (
			<li class={`border-t pt-6 ${onDark ? 'border-current/20' : 'border-line'}`}>
				<Heading level={childLevel(headingLevel, Boolean(heading))} size="sm">
					{item.title}
				</Heading>
				{item.body && <p class="mt-3 text-sm leading-relaxed">{item.body}</p>}
			</li>
		))}
	</ul>
</Section>
