---
import type { Offers } from './Offers.schema';
import Section from '../ui/Section.astro';
import Heading from '../ui/Heading.astro';
import Prose from '../ui/Prose.astro';
import Button from '../ui/Button.astro';
import DimensionLine from '../ui/DimensionLine.astro';
import { childLevel } from '../../lib/section-base';

type Props = Offers;

const {
	headingLevel = 'h2',
	eyebrow,
	heading,
	intro,
	columns = '3',
	items = [],
	anchor,
	surface = 'muted',
	spacing = 'md',
	width = 'wide',
} = Astro.props;

const onDark = surface === 'dark' || surface === 'brand';

/*
 * Expired offers are dropped at build time rather than hidden with CSS, so an
 * out-of-date coupon cannot be found in the markup or honoured by a customer
 * who screenshots it. Compared by date only: an offer expiring today is still
 * valid all day.
 */
const today = new Date();
today.setHours(0, 0, 0, 0);

const live = items.filter((item) => {
	if (!item.expires) return true;
	const expiry = new Date(item.expires);
	if (Number.isNaN(expiry.valueOf())) return true;
	expiry.setHours(0, 0, 0, 0);
	return expiry >= today;
});

const dateFormat = new Intl.DateTimeFormat('en-US', {
	month: 'long',
	day: 'numeric',
	year: 'numeric',
});

// A 3-offer row goes 1 column -> 3 at lg with no 2-up stage, which on a tablet
// orphans the third card. A 2-offer row divides evenly, so its 2-up is kept.
const gridCols = { '2': 'sm:grid-cols-2', '3': 'lg:grid-cols-3' };

// One offer per row is highlighted as the lead: the one that carries a CTA, or
// the first otherwise. It gets the brand-forest treatment so a single card
// pulls the eye instead of three equal-weight boxes competing.
const featuredIndex = (() => {
	const withCta = live.findIndex((item) => item.cta);
	return withCta === -1 ? 0 : withCta;
})();
---

{live.length > 0 && (
	<Section anchor={anchor} surface={surface} spacing={spacing} width={width}>
		{(eyebrow || heading || intro) && (
			<header class="mb-12 max-w-2xl">
				{eyebrow && (
					<DimensionLine label={eyebrow} rule="both" onDark={onDark} class="mb-6 max-w-xs" />
				)}
				{heading && (
					<Heading level={headingLevel} size="lg">
						{heading}
					</Heading>
				)}
				{intro && <Prose html={intro} invert={onDark} class="mt-6" />}
			</header>
		)}

		<ul class={`grid gap-6 ${gridCols[columns]}`}>
			{live.map((item, i) => {
				const featured = i === featuredIndex;
				return (
					<li
						class={`coupon flex flex-col ${featured ? 'coupon-featured' : ''} ${
							onDark && !featured ? 'coupon-on-dark' : ''
						}`}
					>
						{/* Perforation notches, punched into each side at the tear line. */}
						<span class="coupon-perf coupon-perf-left" aria-hidden="true" />
						<span class="coupon-perf coupon-perf-right" aria-hidden="true" />

						{featured && <span class="coupon-badge">Most claimed</span>}

						{/*
							The value gets its own header band so the saving is the first
							thing read -- the reason to keep looking at the card at all.
						*/}
						{item.value && (
							<p class="coupon-value display leading-none">{item.value}</p>
						)}

						{/*
							Three alignment lines hold the row together even though each card
							carries a different mix of blocks:
							  - the title sits at the top of the body panel;
							  - the body gets a min-height (~3 lines) so the code block below it
							    starts at the same Y whether the copy runs two lines or three;
							  - the footer (fine print OR cta) is pinned to the card bottom with
							    `mt-auto`, so that last row bottom-aligns across all three.
							The grid already stretches the cards to equal height, which is what
							makes the bottom pin land on one line.
						*/}
						<div class="coupon-body flex flex-1 flex-col p-7">
							<Heading level={childLevel(headingLevel, Boolean(heading))} size="sm">
								{item.title}
							</Heading>

							{item.body && (
								<p class="mt-3 min-h-[4.5rem] text-sm leading-relaxed">{item.body}</p>
							)}

							{item.code && (
								<div class="mt-6">
									<p class="coupon-code-label mb-2 font-mono text-[0.625rem] uppercase tracking-[0.14em]">
										Use code — tap to copy
									</p>
									{/*
											A button, not an input: copying is the only action, and a
											text field invites editing a code that must not change.
										*/}
									<button
										type="button"
										data-copy-code={item.code}
										class="coupon-code group flex w-full items-center justify-center gap-2 rounded-(--radius-brand) border border-dashed px-4 py-3 font-mono text-sm font-semibold uppercase tracking-[0.16em] transition-colors"
									>
										<span data-copy-label>{item.code}</span>
										<svg
											class="coupon-copy-icon size-3.5 shrink-0 opacity-50 transition-opacity group-hover:opacity-100"
											viewBox="0 0 24 24"
											fill="none"
											stroke="currentColor"
											stroke-width="2"
											stroke-linecap="round"
											stroke-linejoin="round"
											aria-hidden="true"
										>
											<rect x="9" y="9" width="13" height="13" rx="2" />
											<path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
										</svg>
									</button>
								</div>
							)}

							{/*
								Footer row -- fine print on most cards, the CTA on the featured
								one -- pinned to the bottom so it lines up across the row.
							*/}
							{(item.expires || item.terms || item.cta) && (
								<div class="mt-auto pt-6">
									{(item.expires || item.terms) && (
										<div class="coupon-fine space-y-2 border-t pt-5 text-xs">
											{item.expires && (
												<p>
													Ends{' '}
													<time datetime={item.expires}>
														{dateFormat.format(new Date(item.expires))}
													</time>
												</p>
											)}
											{item.terms && <p>{item.terms}</p>}
										</div>
									)}

									{item.cta && (
										<div class={item.expires || item.terms ? 'mt-6' : ''}>
											<Button {...item.cta} onDark={onDark || featured} />
										</div>
									)}
								</div>
							)}
						</div>
					</li>
				);
			})}
		</ul>
	</Section>
)}

<style>
	/*
	 * The card is built to read as a physical tear-off coupon: a value band up
	 * top, a body below, and a punched perforation notch on each side edge where
	 * a ticket would tear. The notches are radial-gradient "holes" masked to the
	 * card's own background so they sit flush on any surface.
	 */
	.coupon {
		position: relative;
		overflow: hidden;
		border-radius: var(--radius-media);
		border: 1px solid var(--color-line);
		background: var(--color-surface);
		transition:
			transform 0.35s var(--ease, cubic-bezier(0.16, 1, 0.3, 1)),
			box-shadow 0.35s var(--ease, cubic-bezier(0.16, 1, 0.3, 1)),
			border-color 0.35s ease;
	}

	/*
	 * A brass hairline runs along the top of every card and grows to full
	 * strength on hover -- the accent thread that ties the row together and gives
	 * the otherwise-quiet light cards something that responds to the eye.
	 */
	.coupon-body {
		position: relative;
	}

	.coupon::before {
		content: '';
		position: absolute;
		inset: 0 0 auto 0;
		height: 3px;
		background: var(--color-accent-ink);
		opacity: 0.5;
		transition: opacity 0.35s ease;
		z-index: 2;
	}

	.coupon:hover {
		transform: translateY(-6px);
		box-shadow: 0 24px 50px -28px rgb(20 18 15 / 0.4);
		border-color: color-mix(in srgb, var(--color-accent-ink) 45%, var(--color-line));
	}

	.coupon:hover::before {
		opacity: 1;
	}

	/* Perforation: a notch punched into each side edge where a ticket tears. */
	.coupon-perf {
		content: '';
		position: absolute;
		top: var(--coupon-perf-top, 6rem);
		width: 22px;
		height: 22px;
		border-radius: 999px;
		background: var(--brand-muted);
		border: 1px solid var(--color-line);
		z-index: 3;
	}

	.coupon-perf-left {
		left: -12px;
	}

	.coupon-perf-right {
		right: -12px;
	}

	/*
	 * The value band -- the saving, sitting on a faint brass wash above a dashed
	 * tear line so the number reads like the headline of the ticket.
	 */
	.coupon-value {
		padding: 1.9rem 1.75rem 1.6rem;
		font-size: clamp(2.25rem, 3.6vw, 3.15rem);
		font-weight: 700;
		letter-spacing: -0.01em;
		color: var(--color-accent-ink);
		background: color-mix(in srgb, var(--color-accent-ink) 6%, transparent);
		border-bottom: 2px dashed color-mix(in srgb, var(--color-accent-ink) 30%, var(--color-line));
	}

	.coupon-code-label {
		color: var(--color-accent-ink);
		opacity: 0.85;
	}

	.coupon-code {
		border-color: color-mix(in srgb, var(--color-accent-ink) 55%, transparent);
		color: var(--color-accent-ink);
		background: color-mix(in srgb, var(--color-accent-ink) 6%, transparent);
	}

	.coupon-code:hover {
		border-color: var(--color-accent-ink);
		background: color-mix(in srgb, var(--color-accent-ink) 12%, transparent);
	}

	.coupon-fine {
		border-color: var(--color-line);
		color: var(--color-body);
		opacity: 0.75;
	}

	/*
	 * Featured card: the lead offer in cabinet-forest so one card owns the row,
	 * lifted slightly above its neighbours. Body text uses the bone foreground
	 * (clears AA on forest); brass is reserved for the oversized value, where the
	 * type is large enough to pass as large-text AA, and for accent hairlines.
	 */
	.coupon-featured {
		background: var(--color-brand);
		border-color: var(--color-brand);
		color: var(--color-brand-fg);
	}

	/*
	 * The title comes from the Heading child component, so it carries a different
	 * scope attribute than this file -- a normal scoped descendant selector never
	 * matches it. `:global` reaches across the component boundary, and the global
	 * h1-h4 base rule forcing near-black ink is what we are overriding here.
	 */
	.coupon-featured :global(:is(h1, h2, h3, h4)) {
		color: var(--color-brand-fg);
	}

	/*
	 * The featured card sits level with its neighbours: its emphasis comes from
	 * the forest fill, the "Most claimed" badge and the full-strength brass rule,
	 * not from being raised out of the row. (It keeps the shared hover lift.)
	 */

	/* Brass top rule reads at full strength against forest. */
	.coupon-featured::before {
		background: var(--color-accent);
		opacity: 1;
	}

	.coupon-featured .coupon-value {
		color: var(--color-accent);
		background: color-mix(in srgb, #000 12%, transparent);
		border-bottom-color: color-mix(in srgb, var(--color-brand-fg) 32%, transparent);
	}

	/* Bone, not brass -- this is the low-contrast label the old version failed on. */
	.coupon-featured .coupon-code-label {
		color: var(--color-brand-fg);
		opacity: 0.75;
	}

	.coupon-featured .coupon-code {
		border-color: color-mix(in srgb, var(--color-brand-fg) 45%, transparent);
		color: var(--color-brand-fg);
		background: color-mix(in srgb, var(--color-brand-fg) 8%, transparent);
	}

	.coupon-featured .coupon-code:hover {
		border-color: var(--color-accent);
		background: color-mix(in srgb, var(--color-brand-fg) 15%, transparent);
	}

	.coupon-featured .coupon-fine {
		color: var(--color-brand-fg);
		border-color: color-mix(in srgb, var(--color-brand-fg) 24%, transparent);
		opacity: 0.7;
	}

	/* Notches on the featured card blend into the page ground, not the forest. */
	.coupon-featured .coupon-perf {
		background: var(--brand-muted);
		border-color: color-mix(in srgb, var(--color-brand) 60%, var(--color-line));
	}

	/* A small pill flags the lead offer as the one to take. */
	.coupon-badge {
		position: absolute;
		top: 1.15rem;
		right: 1.15rem;
		z-index: 4;
		border-radius: 999px;
		padding: 0.3rem 0.7rem;
		font-family: var(--font-mono);
		font-size: 0.5625rem;
		font-weight: 500;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--color-accent-fg);
		background: var(--color-accent);
	}

	/* On a dark section, non-featured cards keep the notch flush with the ground. */
	.coupon-on-dark {
		background: transparent;
		border-color: color-mix(in srgb, currentColor 20%, transparent);
	}

	.coupon-on-dark :global(:is(h1, h2, h3, h4)) {
		color: inherit;
	}

	.coupon-on-dark .coupon-value {
		background: color-mix(in srgb, var(--color-accent) 14%, transparent);
	}

	.coupon-on-dark .coupon-perf {
		background: var(--color-dark);
		border-color: color-mix(in srgb, currentColor 20%, transparent);
	}

	@media (prefers-reduced-motion: reduce) {
		.coupon,
		.coupon::before {
			transition: none;
		}

		.coupon:hover {
			transform: none;
		}
	}
</style>

<script>
	// Copy to clipboard, with the label confirming it. Falls back silently to
	// the code simply staying selectable if the API is unavailable.
	document.querySelectorAll('[data-copy-code]').forEach((button) => {
		if (!(button instanceof HTMLElement)) return;
		const code = button.dataset.copyCode ?? '';
		const label = button.querySelector('[data-copy-label]');

		button.addEventListener('click', async () => {
			try {
				await navigator.clipboard.writeText(code);
				if (label) {
					label.textContent = 'Copied';
					window.setTimeout(() => {
						label.textContent = code;
					}, 1600);
				}
			} catch {
				/* Clipboard blocked; the code is still on screen to read. */
			}
		});
	});
</script>
