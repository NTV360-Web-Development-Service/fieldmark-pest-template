---
import type { PageHeader } from './PageHeader.schema';
import Section from '../ui/Section.astro';
import Heading from '../ui/Heading.astro';
import Prose from '../ui/Prose.astro';
import DimensionLine from '../ui/DimensionLine.astro';

type Props = PageHeader;

const {
	variant = 'split',
	headingLevel = 'h1',
	eyebrow,
	heading,
	body,
	image,
	mediaNote,
	priceNote,
	anchor,
	surface = 'muted',
	spacing = 'sm',
	width = 'wide',
} = Astro.props;

const onDark = surface === 'dark' || surface === 'brand';

// The photo caption falls back to the eyebrow so the annotation comes for free.
const note = mediaNote ?? eyebrow;
---

{variant === 'feature' ? (
	<Section anchor={anchor} surface={surface} spacing={spacing} width={width} reveal={false}>
		<div class="max-w-4xl">
			{eyebrow && (
				<DimensionLine label={eyebrow} rule="both" onDark={onDark} class="mb-7 max-w-sm" />
			)}
			<Heading level={headingLevel} size="hero" display class="max-w-3xl text-balance">
				{heading}
			</Heading>
			{body && <Prose html={body} invert={onDark} size="lg" class="mt-7 max-w-2xl" />}
		</div>

		{image && (
			<figure class="relative mt-12 overflow-hidden rounded-(--radius-media)">
				<img
					src={image.src}
					alt={image.alt}
					class="aspect-21/9 w-full object-cover"
					fetchpriority="high"
				/>
				{note && (
					<figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/70 to-transparent p-5 sm:p-8">
						<DimensionLine label={note} rule="both" onDark class="max-w-sm text-white" />
					</figcaption>
				)}
			</figure>
		)}
	</Section>
) : (
	<Section anchor={anchor} surface={surface} spacing={spacing} width={width} reveal={false}>
		<div class={image ? 'grid items-center gap-12 lg:grid-cols-[1.15fr_1fr] lg:gap-16' : ''}>
			<div>
				{eyebrow && (
					<DimensionLine label={eyebrow} rule="both" onDark={onDark} class="mb-7 max-w-xs" />
				)}
				<Heading level={headingLevel} size="xl" display class="text-balance">
					{heading}
				</Heading>
				{body && <Prose html={body} invert={onDark} size="lg" class="mt-7 max-w-xl text-pretty" />}

				{/*
					A spec row anchors the copy column's lower edge against the tall
					photo, so a short summary no longer floats in empty space. Shows
					the entry's price note -- a fact carried nowhere else on the
					opener -- and omits itself entirely when there is none, leaving
					the plainer header untouched. The parent is deliberately not
					repeated here; it already sits in the breadcrumb trail above.
				*/}
				{priceNote && (
					<dl
						class={`mt-9 flex flex-wrap gap-x-10 gap-y-4 border-t pt-6 ${
							onDark ? 'border-current/20' : 'border-line'
						}`}
					>
						<div>
							<dt class="mono-label opacity-60">Price</dt>
							<dd class="mt-1.5 font-display text-xl font-semibold tracking-tight">
								{priceNote}
							</dd>
						</div>
					</dl>
				)}
			</div>

			{image && (
				<figure class="relative overflow-hidden rounded-(--radius-media)">
					<img
						src={image.src}
						alt={image.alt}
						class="aspect-4/3 w-full object-cover"
						fetchpriority="high"
					/>
					{mediaNote && (
						<figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/65 to-transparent p-4 sm:p-6">
							<DimensionLine label={mediaNote} rule="both" onDark class="max-w-xs text-white" />
						</figcaption>
					)}
				</figure>
			)}
		</div>
	</Section>
)}
