---
import type { PricingTiers } from './PricingTiers.schema';
import Section from '../ui/Section.astro';
import Heading from '../ui/Heading.astro';
import Prose from '../ui/Prose.astro';
import Button from '../ui/Button.astro';
import DimensionLine from '../ui/DimensionLine.astro';
import { childLevel } from '../../lib/section-base';
import { iconPaths } from '../../lib/icons';

type Props = PricingTiers;

const {
	headingLevel = 'h2',
	eyebrow,
	heading,
	intro,
	columns = '3',
	toggle,
	tiers = [],
	footnote,
	anchor,
	surface = 'muted',
	spacing = 'md',
	width = 'wide',
} = Astro.props;

const onDark = surface === 'dark' || surface === 'brand';
const cardLevel = childLevel(headingLevel, Boolean(heading));

// A 3-tier row jumps straight from 1 column to 3 at lg, skipping a 2-up stage
// -- on a tablet that stage orphans the third card and breaks the row the
// featured tier sits in. 2- and 4-tier sets divide evenly, so their 2-up is
// fine and kept.
const gridCols = {
	'2': 'sm:grid-cols-2',
	'3': 'lg:grid-cols-3',
	'4': 'sm:grid-cols-2 lg:grid-cols-4',
};

// Every card carries both price sets in the markup; the toggle only flips which
// is shown, so a reader with JS off still sees the primary price rather than a
// dead switch. The alt figures fall back to the primary when a tier leaves them
// off, so a partly-filled toggle never blanks a card.
const hasToggle = Boolean(toggle);

// The featured card is brand-green, so a `primary` (green) CTA all but vanishes
// on it -- fill, card and page all the same forest. Promote it to the brass
// `accent`, which reads as a true button on any surface. An explicitly authored
// non-primary style (secondary/ghost/accent) is still honoured. Mirrors the same
// promotion in CtaBanner.
const tierCtaStyle = (tier: (typeof tiers)[number]) =>
	tier.featured && (!tier.cta?.style || tier.cta.style === 'primary')
		? 'accent'
		: tier.cta?.style;
---

<Section anchor={anchor} surface={surface} spacing={spacing} width={width}>
	{(eyebrow || heading || intro) && (
		<header class="mb-12 max-w-2xl">
			{eyebrow && (
				<DimensionLine label={eyebrow} rule="both" onDark={onDark} class="mb-6 max-w-xs" />
			)}
			{heading && (
				<Heading level={headingLevel} size="lg">
					{heading}
				</Heading>
			)}
			{intro && <Prose html={intro} invert={onDark} class="mt-6" headingStart={4} />}
		</header>
	)}

	{toggle && (
		<div
			class="mb-10 flex flex-wrap items-center gap-4"
			data-pricing-toggle
			data-mode="primary"
		>
			<div
				class={`inline-flex rounded-(--radius-brand) border p-1 ${
					onDark ? 'border-current/25' : 'border-line bg-surface'
				}`}
				role="group"
				aria-label="Billing option"
			>
				<button
					type="button"
					data-toggle-primary
					aria-pressed="true"
					class="min-h-9 rounded-[calc(var(--radius-brand)-0.25rem)] px-5 font-mono text-[0.625rem] font-medium uppercase tracking-[0.14em] transition-colors"
				>
					{toggle.primaryLabel}
				</button>
				<button
					type="button"
					data-toggle-alt
					aria-pressed="false"
					class="min-h-9 rounded-[calc(var(--radius-brand)-0.25rem)] px-5 font-mono text-[0.625rem] font-medium uppercase tracking-[0.14em] transition-colors"
				>
					{toggle.altLabel}
				</button>
			</div>
			{toggle.note && (
				<p class="font-mono text-[0.6875rem] tracking-[0.08em] opacity-65">{toggle.note}</p>
			)}
		</div>
	)}

	<ul class={`grid gap-6 ${gridCols[columns]}`}>
		{tiers.map((tier) => (
			<li
				class={`tier relative flex flex-col rounded-(--radius-media) p-6 sm:p-8 ${
					tier.featured
						? 'tier-featured bg-brand text-brand-fg ring-2 ring-accent'
						: onDark
							? 'border border-current/20'
							: 'border border-line bg-surface'
				}`}
			>
				{tier.badge && (
					<span
						class={`absolute -top-3 left-8 inline-flex items-center gap-2 rounded-(--radius-brand) px-3 py-1.5 font-mono text-[0.625rem] font-medium uppercase tracking-[0.16em] ${
							tier.featured ? 'bg-accent text-accent-fg' : 'bg-brand text-brand-fg'
						}`}
					>
						{tier.badge}
					</span>
				)}

				<Heading level={cardLevel} size="sm" display class="text-current">
					{tier.name}
				</Heading>

				{/* Price. Both sets live in the DOM; the toggle swaps which shows. */}
				<div class="mt-5">
					{tier.priceLabel && (
						<span class="block font-mono text-[0.625rem] uppercase tracking-[0.16em] opacity-70">
							{tier.priceLabel}
						</span>
					)}
					<span class="mt-1 flex items-baseline gap-1.5">
						<span
							class="display text-[clamp(2rem,3.4vw,2.75rem)] leading-none"
							data-price-primary={tier.price}
							data-price-alt={hasToggle ? (tier.priceAlt ?? tier.price) : undefined}
						>
							{tier.price}
						</span>
						{(tier.priceUnit || tier.priceAltUnit) && (
							<span
								class="font-mono text-[0.6875rem] uppercase tracking-[0.14em] opacity-70"
								data-unit-primary={tier.priceUnit ?? ''}
								data-unit-alt={hasToggle ? (tier.priceAltUnit ?? tier.priceUnit ?? '') : undefined}
							>
								{tier.priceUnit}
							</span>
						)}
					</span>
					{tier.note && (
						<p class="mt-2 text-xs leading-relaxed opacity-70">{tier.note}</p>
					)}
				</div>

				{tier.features.length > 0 && (
					<ul class={`mt-7 space-y-3 border-t pt-6 ${tier.featured ? 'border-current/20' : 'border-line'}`}>
						{tier.features.map((feature) => (
							<li class="flex items-start gap-3 text-sm leading-relaxed">
								<svg
									viewBox="0 0 24 24"
									class={`mt-0.5 h-4 w-4 shrink-0 ${tier.featured ? 'text-accent' : 'text-accent-ink'}`}
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
									aria-hidden="true"
								>
									<path d={iconPaths.check} />
								</svg>
								<span class={tier.featured ? '' : 'opacity-85'}>{feature}</span>
							</li>
						))}
					</ul>
				)}

				{tier.cta && (
					<div class="mt-8 pt-2">
						<Button
							{...tier.cta}
							style={tierCtaStyle(tier)}
							onDark={tier.featured || onDark}
							class="w-full"
						/>
					</div>
				)}
			</li>
		))}
	</ul>

	{footnote && (
		<p class={`mt-8 text-xs leading-relaxed ${onDark ? 'opacity-70' : 'opacity-60'}`}>{footnote}</p>
	)}
</Section>

<style>
	/*
	 * The featured tier is always the forest-green card, whatever surface the
	 * section sits on. On a light or muted section, though, the Section wrapper
	 * sets every heading inside it to that surface's DARK heading colour via a
	 * `[& :is(h1..h4)]` descendant rule -- which also reaches the title inside the
	 * dark featured card, rendering dark-on-dark. The tier name carries `.text-current`,
	 * but a utility class cannot outrank that descendant selector.
	 *
	 * `:global` reaches across to the Heading child component, and the scoped
	 * `.tier-featured` attribute gives this enough specificity to win, so the
	 * featured title always reads in the bone foreground. (Mirrors the same fix in
	 * Offers.astro's coupon-featured card.)
	 */
	.tier-featured :global(:is(h1, h2, h3, h4)) {
		color: var(--color-brand-fg);
	}
</style>

<script>
	// Flips every card between its primary and alt price set. Purely a display
	// swap of text already in the DOM, so nothing is fetched and JS-off readers
	// keep the primary price.
	document.querySelectorAll('[data-pricing-toggle]').forEach((group) => {
		if (!(group instanceof HTMLElement)) return;

		const primaryBtn = group.querySelector<HTMLButtonElement>('[data-toggle-primary]');
		const altBtn = group.querySelector<HTMLButtonElement>('[data-toggle-alt]');
		const section = group.closest('section');
		if (!primaryBtn || !altBtn || !section) return;

		const activeClasses = ['bg-brand', 'text-brand-fg'];

		const paint = (mode: 'primary' | 'alt') => {
			const on = mode === 'primary' ? primaryBtn : altBtn;
			const off = mode === 'primary' ? altBtn : primaryBtn;
			on.classList.add(...activeClasses);
			on.setAttribute('aria-pressed', 'true');
			off.classList.remove(...activeClasses);
			off.setAttribute('aria-pressed', 'false');

			section.querySelectorAll<HTMLElement>('[data-price-primary]').forEach((el) => {
				const next = mode === 'primary' ? el.dataset.pricePrimary : el.dataset.priceAlt;
				if (next != null) el.textContent = next;
			});
			section.querySelectorAll<HTMLElement>('[data-unit-primary]').forEach((el) => {
				const next = mode === 'primary' ? el.dataset.unitPrimary : el.dataset.unitAlt;
				if (next != null) el.textContent = next;
			});
		};

		// Paint the starting state so the active button reads as selected on load.
		paint('primary');
		primaryBtn.addEventListener('click', () => paint('primary'));
		altBtn.addEventListener('click', () => paint('alt'));
	});
</script>
