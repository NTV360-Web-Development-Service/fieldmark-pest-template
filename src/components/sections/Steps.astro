---
import type { Steps } from './Steps.schema';
import Section from '../ui/Section.astro';
import Heading from '../ui/Heading.astro';
import { childLevel } from '../../lib/section-base';
import Prose from '../ui/Prose.astro';
import DimensionLine from '../ui/DimensionLine.astro';

type Props = Steps;

const {
	headingLevel = 'h2',
	eyebrow,
	heading,
	intro,
	steps = [],
	anchor,
	surface = 'muted',
	spacing = 'md',
	width = 'wide',
} = Astro.props;

const onDark = surface === 'dark' || surface === 'brand';
---

<Section anchor={anchor} surface={surface} spacing={spacing} width={width}>
	{(eyebrow || heading || intro) && (
		<header class="mb-14 max-w-2xl">
			{eyebrow && (
				<DimensionLine label={eyebrow} rule="both" onDark={onDark} class="mb-6 max-w-xs" />
			)}
			{heading && (
				<Heading level={headingLevel} size="lg">
					{heading}
				</Heading>
			)}
			{intro && <Prose html={intro} invert={onDark} class="mt-6" />}
		</header>
	)}

	{/*
		An ordered list, because the order carries the information: these happen
		in sequence. The visible numbers come from the markup rather than being
		typed into the content, so reordering in the CMS renumbers correctly.
	*/}
	<ol class="grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-4">
		{steps.map((step, i) => (
			<li class="relative">
				<span
					class={`font-mono text-[0.6875rem] font-medium uppercase tracking-[0.14em] ${
						onDark ? 'text-accent' : 'text-accent-ink'
					}`}
				>
					{String(i + 1).padStart(2, '0')}
				</span>
				<span
					class={`mt-3 mb-5 block h-px w-full ${onDark ? 'bg-current/25' : 'bg-line'}`}
					aria-hidden="true"
				/>
				<Heading level={childLevel(headingLevel, Boolean(heading))} size="sm">
					{step.title}
				</Heading>
				{step.body && <p class="mt-3 text-sm leading-relaxed">{step.body}</p>}
			</li>
		))}
	</ol>
</Section>
