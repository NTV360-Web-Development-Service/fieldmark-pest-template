---
import type { Team } from './Team.schema';
import Section from '../ui/Section.astro';
import Heading from '../ui/Heading.astro';
import Button from '../ui/Button.astro';
import { childLevel } from '../../lib/section-base';
import Prose from '../ui/Prose.astro';
import DimensionLine from '../ui/DimensionLine.astro';

type Props = Team;

const {
	headingLevel = 'h2',
	eyebrow,
	heading,
	intro,
	columns = '3',
	members = [],
	cta,
	anchor,
	surface = 'light',
	spacing = 'md',
	width = 'wide',
} = Astro.props;

const onDark = surface === 'dark' || surface === 'brand';

const gridCols = {
	'2': 'sm:grid-cols-2',
	'3': 'sm:grid-cols-2 lg:grid-cols-3',
	'4': 'sm:grid-cols-2 lg:grid-cols-4',
};
---

<Section anchor={anchor} surface={surface} spacing={spacing} width={width}>
	{(eyebrow || heading || intro) && (
		<header class="mx-auto mb-14 max-w-2xl text-center">
			{eyebrow && (
				<DimensionLine
					label={eyebrow}
					rule="both"
					onDark={onDark}
					class="mx-auto mb-6 max-w-xs justify-center"
				/>
			)}
			{heading && (
				<Heading level={headingLevel} size="lg">
					{heading}
				</Heading>
			)}
			{intro && <Prose html={intro} invert={onDark} class="mt-6" />}
		</header>
	)}

	<ul class={`grid gap-x-8 gap-y-12 ${gridCols[columns]}`}>
		{members.map((member) => (
			<li class="flex flex-col text-center">
				{member.photo && (
					<div class="mb-6 aspect-square overflow-hidden rounded-(--radius-media)">
						<img
							src={member.photo.src}
							alt={member.photo.alt}
							loading="lazy"
							class="h-full w-full object-cover"
						/>
					</div>
				)}
				<Heading level={childLevel(headingLevel, Boolean(heading))} size="sm">
					{member.name}
				</Heading>
				{member.role && (
					<p class="mt-2 font-mono text-[0.6875rem] font-medium uppercase tracking-[0.14em] text-accent-ink">
						{member.role}
					</p>
				)}
				{member.bio && (
					<p class="mx-auto mt-3.5 max-w-[30ch] text-sm leading-relaxed opacity-85">
						{member.bio}
					</p>
				)}
			</li>
		))}
	</ul>

	{cta && (
		<div class="mt-14 flex justify-center">
			<Button {...cta} onDark={onDark} />
		</div>
	)}
</Section>
